@article{kongRecentAdvancesAssembly2023,
 abstract = {Over the past 20 years, tremendous advances in sequencing technologies and computational algorithms have spurred plant genomic research into a thriving era with hundreds of genomes decoded already, ranging from those of nonvascular plants to those of flowering plants. However, complex genome assembly is still challenging and remains difficult to fully resolve with conventional sequencing and assembly methods due to the high heterozygosity, repetitive sequences, or high ploidy characteristics of complex genomes. Herein, we summarize the challenges of and advances in complex plant genome assembly, including feasible experimental strategies, upgrades to sequencing technology, existing assembly methods, and different phasing algorithms. Moreover, we list actual cases of complex genome projects for readers to refer to and draw upon to solve future problems related to complex genomes. Finally, we expect that the accurate, gapless, telomere-to-telomere, and fully phased assembly of complex plant genomes could soon become routine.},
 annotation = {TLDR: The challenges of and advances in complex plant genome assembly are summarized, including feasible experimental strategies, upgrades to sequencing technology, existing assembly methods, and different phasing algorithms.},
 author = {Kong, Weilong and Wang, Yibin and Zhang, Shengcheng and Yu, Jiaxin and Zhang, Xingtan},
 doi = {10.1016/j.gpb.2023.04.004},
 file = {/Users/yibin/Data_scientist_win/Reference/Zotero/storage/7EMQYGML/Kong 等 - 2023 - Recent Advances in Assembly of Plant Complex Genomes.pdf;/Users/yibin/Data_scientist_win/Reference/Zotero/storage/7H4YBPTC/S1672022923000700.html},
 issn = {1672-0229},
 journal = {Genomics, Proteomics & Bioinformatics},
 keywords = {Assembly algorithms,Haplotype-resolved assembly,Plant complex genome,Sequencing technology,Telomere-to-telomere genome},
 langid = {english},
 month = {April},
 title = {Recent Advances in Assembly of Plant Complex Genomes},
 urldate = {2023-05-06},
 year = {2023}
}

