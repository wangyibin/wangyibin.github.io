@article{chenGeneMiningGenomicsassisted2023,
  title = {Gene Mining and Genomics-Assisted Breeding Empowered by the Pangenome of Tea Plant {{Camellia}} Sinensis},
  author = {Chen, Shuai and Wang, Pengjie and Kong, Weilong and Chai, Kun and Zhang, Shengcheng and Yu, Jiaxin and Wang, Yibin and Jiang, Mengwei and Lei, Wenlong and Chen, Xiao and Wang, Wenling and Gao, Yingying and Qu, Shenyang and Wang, Fang and Wang, Yinghao and Zhang, Qing and Gu, Mengya and Fang, Kaixing and Ma, Chunlei and Sun, Weijiang and Ye, Naixing and Wu, Hualing and Zhang, Xingtan},
  year = 2023,
  month = nov,
  journal = {Nature Plants},
  pages = {1--14},
  publisher = {Nature Publishing Group},
  issn = {2055-0278},
  doi = {10.1038/s41477-023-01565-z},
  urldate = {2023-11-28},
  abstract = {Tea is one of the world's oldest crops and is cultivated to produce beverages with various flavours. Despite advances in sequencing technologies, the genetic mechanisms underlying key agronomic traits of tea remain unclear. In this study, we present a high-quality pangenome of 22 elite cultivars, representing broad genetic diversity in the species. Our analysis reveals that a recent long terminal repeat burst contributed nearly 20\% of gene copies, introducing functional genetic variants that affect phenotypes such as leaf colour. Our graphical pangenome improves the efficiency of genome-wide association studies and allows the identification of key genes controlling bud flush timing. We also identified strong correlations between allelic variants and flavour-related chemistries. These findings deepen our understanding of the genetic basis of tea quality and provide valuable genomic resources to facilitate its genomics-assisted breeding.},
