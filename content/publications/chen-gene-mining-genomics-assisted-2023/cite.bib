  langid = {english},
  keywords = {Genomics,Plant genetics},
  file = {/Users/yibin/Data_scientist_win/Reference/Zotero/storage/9K6F94AR/Chen et al_2023_Gene mining and genomics-assisted breeding empowered by the pangenome of tea.pdf}
}
