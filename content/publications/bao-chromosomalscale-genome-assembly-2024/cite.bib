@article{baoChromosomalscaleGenomeAssembly2024,
 abstract = {Sugarcane is a vital crop with significant economic and industrial value. However, the cultivated sugarcane's ultra-complex genome still needs to be resolved due to its high ploidy and extensive recombination between the two subgenomes. Here, we generate a chromosomal-scale, haplotype-resolved genome assembly for a hybrid sugarcane cultivar ZZ1. This assembly contains 10.4\,Gb genomic sequences and 68,509 annotated genes with defined alleles in two sub-genomes distributed in 99 original and 15 recombined chromosomes. RNA-seq data analysis shows that sugar accumulation-associated gene families have been primarily expanded from the ZZSO subgenome. However, genes responding to pokkah boeng disease susceptibility have been derived dominantly from the ZZSS subgenome. The region harboring the possible smut resistance genes has expanded significantly. Among them, the expansion of WAK and FLS2 families is proposed to have occurred during the breeding of ZZ1. Our findings provide insights into the complex genome of hybrid sugarcane cultivars and pave the way for future genomics and molecular breeding studies in sugarcane.},
 annotation = {TLDR: A chromosomal-scale, haplotype-resolved genome assembly for a hybrid sugarcane cultivar ZZ1 is generated and shows that sugar accumulation-associated gene families have been primarily expanded from the ZZSO subgenome, and the region harboring the possible smut resistance genes has expanded significantly.},
 author = {Bao, Yixue and Zhang, Qing and Huang, Jiangfeng and Zhang, Shengcheng and Yao, Wei and Yu, Zehuai and Deng, Zuhu and Yu, Jiaxin and Kong, Weilong and Yu, Xikai and Lu, Shan and Wang, Yibin and Li, Ru and Song, Yuhan and Zou, Chengwu and Xu, Yuzhi and Liu, Zongling and Yu, Fan and Song, Jiaming and Huang, Youzong and Zhang, Jisen and Wang, Haifeng and Chen, Baoshan and Zhang, Xingtan and Zhang, Muqing},
 copyright = {2024 The Author(s)},
 doi = {10.1038/s41467-024-47390-6},
 file = {/Users/yibin/Data_scientist_win/Reference/Zotero/storage/IZU8D2MV/Bao et al_2024_A chromosomal-scale genome assembly of modern cultivated hybrid sugarcane.pdf},
 issn = {2041-1723},
 journal = {Nature Communications},
 keywords = {Agricultural genetics,Comparative genomics,Evolutionary genetics,Plant breeding},
 langid = {english},
 month = {April},
 number = {1},
 pages = {3041},
 publisher = {Nature Publishing Group},
 title = {A Chromosomal-Scale Genome Assembly of Modern Cultivated Hybrid Sugarcane Provides Insights into Origination and Evolution},
 urldate = {2024-04-18},
